{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stalir.cn/schemas/mc-bridge/outbox.schema.json",
  "title": "McBridge outbox response",
  "description": "Response body of GET /api/mc-bridge/outbox.",
  "type": "object",
  "required": ["ok", "server_key", "messages"],
  "additionalProperties": true,
  "properties": {
    "ok": { "type": "boolean", "const": true },
    "server_key": { "type": "string" },
    "peek": {
      "type": "boolean",
      "description": "True when the messages were not consumed."
    },
    "messages": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/message" }
    }
  },
  "$defs": {
    "message": {
      "type": "object",
      "required": ["id", "type"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "type": {
          "type": "string",
          "enum": ["announcement", "broadcast", "command"]
        },
        "title": { "type": ["string", "null"], "maxLength": 255 },
        "body": { "type": ["string", "null"], "maxLength": 4000 },
        "url": {
          "type": ["string", "null"],
          "maxLength": 255,
          "description": "Relative forum path, e.g. /d/12."
        },
        "payload": {
          "type": "object",
          "description": "Type specific extras. For type=command this carries {\"command\": \"...\"}.",
          "additionalProperties": true
        },
        "created_at": { "type": ["string", "null"] }
      }
    }
  }
}
