{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stalir.cn/schemas/mc-bridge/events.schema.json",
  "title": "McBridge gameplay events",
  "description": "POST /api/mc-bridge/events request body. At most 100 events per request.",
  "type": "object",
  "required": ["server_key", "events"],
  "additionalProperties": true,
  "properties": {
    "server_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,100}$"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/event" }
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "join",
            "quit",
            "death",
            "advancement",
            "chat",
            "command",
            "start",
            "stop",
            "custom"
          ]
        },
        "player_uuid": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{12}$"
        },
        "player_name": {
          "type": "string",
          "maxLength": 64
        },
        "message": {
          "type": "string",
          "maxLength": 4000,
          "description": "Free-form detail, e.g. the death cause or advancement key."
        },
        "happened_at": {
          "type": "string",
          "description": "ISO-8601 timestamp; defaults to the server's receive time."
        }
      }
    }
  }
}
